# === DJANGO ===
SECRET_KEY=django-insecure-cambia-esto-en-produccion-por-una-clave-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === BASE DE DATOS POSTGRESQL ===
DB_NAME=smartstock
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# === JWT ===
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# === RECUPERACIÓN DE CONTRASEÑA (solo producción / Render) ===
# Resend funciona por HTTPS (Render Free bloquea SMTP).
# Configurar solo como variables privadas de Render, nunca guardar la clave real en Git.
# RESEND_API_KEY=re_tu_clave_real
# DEFAULT_FROM_EMAIL=SmartStock <contacto@smartstockchile.cl>
# Debes verificar el dominio remitente en Resend y configurar los DNS en Cloudflare.
# Los emails de recuperación se imprimen en la terminal durante desarrollo local.

# === ALERTAS SMS (activas para pruebas y demostraciones; Twilio cobra por el envío) ===
SMS_ALERTAS_ACTIVAS=True
SMS_ALERTAS_DESTINATARIOS=
SMS_ALERTAS_LIMITE_DIARIO=100
SMS_ALERTAS_TIMEOUT=3
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Usar un Messaging Service con remitente SMS, o TWILIO_FROM_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_PUBLIC_BASE_URL=https://smartstockchile.cl
# Máximo 3 destinatarios móviles chilenos autorizados, separados por coma.
# Formato: +569XXXXXXXX. Nunca guardar credenciales ni teléfonos reales en Git.
# Se requiere configuración completa para enviar. False permite pausar los SMS.

